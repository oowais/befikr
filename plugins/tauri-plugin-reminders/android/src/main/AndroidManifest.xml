<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Sync: scan the other device's pairing QR code (in the webview, getUserMedia). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- Sync: connections to paired devices (direct or via relay). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update: install a newer Befikr APK (system asks to confirm). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Voice quick add: see whether a speech recogniser app is installed (Android 11+ visibility). -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application>
        <!-- "Share → Befikr" from other apps: merged into the app's main activity;
             RemindersPlugin turns the shared text into a quick add route. -->
        <activity android:name="com.befikr.app.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <!-- Notification Snooze: a sheet over whatever is on screen, in its own
             task so the app doesn't open behind it. -->
        <activity
            android:name="com.befikr.reminders.SnoozeActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true" />
        <receiver android:name="com.befikr.reminders.AlarmReceiver" android:exported="false" />
        <receiver android:name="com.befikr.reminders.ActionReceiver" android:exported="false" />
        <receiver android:name="com.befikr.reminders.DigestReceiver" android:exported="false" />
        <!-- Home-screen widget; exported for the launcher's update broadcasts.
             Its tick boxes go to ActionReceiver (not exported). -->
        <receiver android:name="com.befikr.reminders.TasksWidget" android:exported="true" android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/befikr_widget_info" />
        </receiver>
        <receiver android:name="com.befikr.reminders.BackupReceiver" android:exported="false" />
        <receiver android:name="com.befikr.reminders.UpdateReceiver" android:exported="false" />
        <receiver android:name="com.befikr.reminders.RestoreReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
