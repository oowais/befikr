{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Befikr",
  "version": "0.1.0",
  "identifier": "com.owaisahmed.befikr",
  "build": {
    "frontendDist": "../.output/public",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm generate"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Befikr", "width": 420, "height": 820 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "shortDescription": "Private, local-first to-do list with reliable reminders",
    "longDescription": "Type a task in plain English, get a reliable reminder. No server; your data stays on your devices.",
    "category": "Productivity",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": { "deb": { "desktopTemplate": "../packaging/linux/befikr.desktop" } },
    "android": { "minSdkVersion": 26 }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5NzVFOTc4QkQ5RjgwNTQKUldSVWdKKzllT2wxMllsT3IrQVd2Z3BldW8zVDR1d3VkV1BTbWtTUEFxVXBFZlNENGhMY1UreGQK",
      "endpoints": ["https://github.com/oowais/befikr/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
